.his_price{
  background-color: #ececec;
  color: rgb(14, 26, 192);
  padding: 4rpx 16rpx;
  border-radius: 10rpx;

}

.circle.gray{
  background: #374947;
}


.border-radius-40{
  border-radius: 40rpx;
  border: 1px solid lightgray;


}


.shelf-tools-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.35);
  z-index: 10000;
}

.shelf-tools-panel {
  position: fixed;
  right: 40rpx;
  z-index: 10001;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.12);
}

.shelf-layer-divider {
  width: 100%;
  padding: 20rpx 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.divider-line {
  flex: 1;
  height: 4rpx;
  background-color: #12a085;
  border-radius: 4rpx;
}

.divider-text {
  margin: 0 26rpx;
  font-size: 26rpx;
  color: #0a8a72;
  font-weight: 600;
}

.shelf-list-wrap {
  padding: 20rpx;
}

.shelf-list-item {
  display: flex;
  align-items: flex-start;
  background-color: #fff;
  border-radius: 24rpx;
  border: 1px solid #e5e5e5;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.shelf-list-thumb {
  width: 160rpx;
  height: 160rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #f5f5f5;
}

.shelf-list-img {
  width: 100%;
  height: 100%;
}

.shelf-list-img.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.shelf-list-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.shelf-list-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.shelf-list-brand {
  font-size: 26rpx;
  color: #0a8a72;
  padding: 0 14rpx;
  background-color: rgba(10, 138, 114, 0.12);
  border-radius: 12rpx;
}

.shelf-list-title-text {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
}

.shelf-list-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.shelf-list-spec {
  font-size: 26rpx;
  color: #7a8594;
}

.shelf-list-stock {
  display: flex;
  align-items: flex-start;
  font-size: 26rpx;
  color: #666;
  gap: 12rpx;
  margin-top: 16rpx;
}

.shelf-list-stock-label {
  color: #666;
}

.stock-num {
  color: #147062;
  font-weight: 600;
}

.stock-empty {
  color: #999;
}

.overlay .popup {
  top: 12% !important;
  transform: translate(-50%, 0) !important;
  width: 92% !important;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.18);
}

.shelf-list-tag {
  margin-left: 20rpx;
  display: flex;
  align-items: center;
}

.shelf-card-wrap {
  width: 48%;
  margin: 0 2% 24rpx 0;
  position: relative;
  box-sizing: border-box;
}
.shelf-card-wrap:nth-child(2n) {
  margin-right: 0;
}

.shelf-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #e9eff2;
  min-height: 220rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.shelf-card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.shelf-card-brand {
  font-size: 24rpx;
  padding: 4rpx 18rpx;
  color: #0a8a72;
  background: rgba(18, 160, 133, 0.12);
  border-radius: 20rpx;
}

.shelf-card-title {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
}

.shelf-card-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2f3d;
}

.shelf-card-spec {
  font-size: 26rpx;
  color: #7a8594;
}

.shelf-card-stock {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  flex: 1;
  align-items: flex-start;
}

.stock-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #e9efff;
  color: #3171ff;
  padding: 8rpx 22rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.2;
}

.shelf-card-empty {
  color: #b0b7c3;
  font-size: 26rpx;
}

.shelf-card-tag {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
}
.shelf-card-tag .circle {
  margin: 0;
  width: 90rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  
}

.confirm-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 10000;
}

.confirm-overlay.show {
  display: flex;
}

.confirm-modal {
  width: 70%;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.confirm-title {
  font-size: 34rpx;
  font-weight: 600;
  padding: 30rpx;
  text-align: center;
  border-bottom: 1px solid #f0f0f0;
}

.confirm-content {
  padding: 40rpx 30rpx;
  font-size: 30rpx;
  color: #555;
  text-align: center;
}

.confirm-actions {
  display: flex;
  border-top: 1px solid #f0f0f0;
}

.confirm-btn {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 30rpx;
}

.confirm-btn.cancel {
  color: #666;
  border-right: 1px solid #f0f0f0;
}

.confirm-btn.danger {
  color: #ff4d4f;
  font-weight: 600;
}

.empty-hint {
  flex-direction: column;
  text-align: center;
  gap: 16rpx;
}