			<image class='log_img' src='../../images/logo.jpg'></image>
		</view> -->
		<view class='word'>特鲜送</view>
		<view class="small gray" style="margin-bottom: 40rpx;">专业配送商户专用版</view>

	<view class="flex-column" >
    <view class="flex-row" style="width: {{windowWidth - 40}}rpx; margin-top: 20rpx">
		<text class="margin-l-right" style="width: 220rpx; text-align: right;">注册类型:</text>
		<view class='what'  style="width: {{windowWidth - 280}}rpx;">
			<input class='input middle' type='text' placeholder='选择经营类型' name='typeName' value='{{typeName}}' bindtap='showSelect' disabled="false"></input>
		</view>
	 </view>

    <view class="flex-row" style="width: {{windowWidth - 40}}rpx; margin-top: 20rpx" >
		<text class="margin-l-right" style="width: 220rpx; text-align: right;">注册类型:</text>
		<view class='what'  style="width: {{windowWidth - 280}}rpx;">
			<input class='input middle' type='text' placeholder='批发市场' name='marketName' value='{{marketName}}' bindtap='showMarket' disabled="false"></input>
		</view>
	 </view>

   <view class="flex-row-between with-padding" style="width: {{windowWidth - 40}}rpx; margin-top: 20rpx" >
		<text class="margin-l-right" style="width: 220rpx; text-align: right;">是否下载目录:</text>
		<view class='' >
      <switch checked="{{down ? 'true' : ''}}" bindchange="downIf"/>
		</view>
	 </view>


	  <view class="flex-row" style="width: {{windowWidth - 40}}rpx; ">
		<text class="margin-l-right" style="width: 220rpx; text-align: right;">批发商名称:</text>
		<view class='what'  style="width: {{windowWidth - 280}}rpx;">
			<input class='input middle' type='text' placeholder='批发商名称' name='name' value='{{name}}' bindblur='getName'  bindconfirm="_canLogin" ></input>
		</view>
	 </view>


