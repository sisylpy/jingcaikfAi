
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

.header {
  flex: 0 0 auto;
}

.list {
  flex: 1 1 auto;
  min-height: 0;
}


.wx_part{
  width: 100%;
  padding: 20rpx 20rpx;
  position: fixed;
  bottom: 0;
  background-color: rgb(2, 179, 96);
  color: #fff;
  z-index: 9999999;
}

.goodsBack{
  background: rgb(235, 242, 245);
 
  margin-right:30rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
}

.word_back{
  background-color: rgba(46, 46, 46, 0.8);
  height: 90rpx;
  line-height: 90rpx;
  color: rgb(216, 215, 215);
  padding-left: 40rpx;
  font-size: 34rpx;
}

.dot{
  border: 1px solid gray;
  /* border-radius: 50%; */
  width: 40rpx;
  height: 40rpx;
  display: block;
}

/* 美化按钮容器 */
.button-container {
  position: relative;
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.button-container:active {
  background-color: #e0e0e0;
  transform: scale(0.95);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
}

.button-container .icon {
  width: 40rpx;
  height: 40rpx;
}

/* 侧边栏样式 */
.sidebar-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
}

.sidebar-content {
  width: 600rpx;
  max-width: 80%;
  height: 100%;
  background-color: #fff;
  box-shadow: 2rpx 0 10rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  animation: slideInLeft 0.3s ease-out;
}

@keyframes slideInLeft {
  from {
    transform: translateX(-100%);
  }
  to {
    transform: translateX(0);
  }
}

.sidebar-header {
  height: 100rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #e5e5e5;
  background-color: #f8f8f8;
}

.sidebar-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.sidebar-close {
  font-size: 50rpx;
  color: #999;
  line-height: 1;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sidebar-close:active {
  color: #333;
}

.sidebar-list {
  flex: 1;
  overflow-y: auto;
}

.sidebar-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #fff;
  transition: background-color 0.2s;
}

.sidebar-item:active {
  background-color: #f5f5f5;
}

.sidebar-item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.sidebar-item-name {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.sidebar-item-desc {
  font-size: 26rpx;
  color: #999;
}

.sidebar-item-check {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-icon {
  font-size: 36rpx;
  color: #02b360;
  font-weight: bold;
}

.sidebar-empty {
  padding: 100rpx 30rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}
